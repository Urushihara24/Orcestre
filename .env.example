# ============================================================
# TELEGRAM BOT
# ============================================================
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
ADMIN_TELEGRAM_ID=123456789
# Optional: multiple admins (comma/space separated).
# ADMIN_TELEGRAM_IDS=123456789,987654321

# ============================================================
# DATABASE
# ============================================================
# SQLite is the safe default for local development.
DB_URL=sqlite:///./bot_data.db
# PostgreSQL example:
# DB_URL=postgresql+psycopg://username:password@localhost:5432/orcestre

# ============================================================
# PROCESSING
# ============================================================
MAX_TASKS_PER_TICK=10
PROCESS_TICK_SECONDS=10
DAILY_RESET_HOUR_UTC=0

# ============================================================
# DEFAULTS
# ============================================================
DEFAULT_DAILY_LIMIT=5
DEFAULT_SEND_JITTER_MIN_SEC=120
DEFAULT_SEND_JITTER_MAX_SEC=300
DEFAULT_TARGET_SENDERS_COUNT=1
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_MIN_REQUEST_INTERVAL_SEC=30
DEFAULT_MAX_REQUEST_INTERVAL_SEC=60
DEFAULT_HOURLY_API_LIMIT=50
DEFAULT_DAILY_API_LIMIT=100
DEFAULT_RECHECK_DAILY_LIMIT=10
DAILY_REPEAT_CAMPAIGN_ENABLED=0
LOG_RETENTION_DAYS=14

DEVICE_AUTH_TIMEOUT_SEC=120
SEND_REQUESTS_ENABLED=0
ALLOW_SHOW_PASSWORD=0

# DRY_RUN=1 disables Epic network calls in the queue worker.
DRY_RUN=1

# Leave empty to keep device-auth data in the database only.
DEVICE_AUTHS_JSON_PATH=

# Keep password-only device-auth generation disabled unless explicitly needed.
ALLOW_PASSWORD_DEVICE_AUTH_BATCH=0

# Epic OAuth/app credentials. Never commit real values.
EPIC_SWITCH_TOKEN=replace_with_epic_switch_token
EPIC_ANDROID_TOKEN=replace_with_epic_android_token
EPIC_CLIENT_ID=replace_with_epic_client_id
EPIC_CLIENT_SECRET=replace_with_epic_client_secret
